# Hygraph (https://hygraph.com) – free tier
# 1. Create a free account and a new project at https://app.hygraph.com
# 2. Build the content models (see README.md for schemas)
# 3. Go to Settings → API Access and copy the Content API URL
# 4. Create two Permanent Auth Tokens:
#    - HYGRAPH_TOKEN: read-only (Queries only)
#    - HYGRAPH_MUTATION_TOKEN: write access (Mutations + Publishing)

HYGRAPH_ENDPOINT=https://YOUR_REGION.hygraph.com/v2/YOUR_PROJECT_ID/master
HYGRAPH_TOKEN=your_read_only_token_here
HYGRAPH_MUTATION_TOKEN=your_mutation_token_here

# Mistral AI (https://mistral.ai) – for Tidal playlist suggestions
MISTRAL_API_KEY=your_mistral_api_key_here

# Tidal Developer Platform (https://developer.tidal.com)
# 1. Create a developer account at https://developer.tidal.com
# 2. Create a new application
# 3. Copy your Client ID and Client Secret
# 4. Add redirect URI: http://localhost:5173/tidal/callback (development)
TIDAL_CLIENT_ID=your_tidal_client_id
TIDAL_CLIENT_SECRET=your_tidal_client_secret

