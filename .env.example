# FaunaDB (existing)
FAUNA_GRAPHQL_URL=https://graphql.fauna.com/graphql
FAUNA_GUEST_KEY=
FAUNA_SERVER_KEY=

# Tidal Developer API (https://developer.tidal.com/)
# Register your app to get these credentials.
# Ensure "Authorization Code + PKCE" is enabled for your app
# and add your redirect URI (e.g. http://localhost:3000/tidal).
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# OpenAI API (https://platform.openai.com/api-keys)
# Used by the server-side suggestions middleware; never exposed to the browser.
OPENAI_API_KEY=
