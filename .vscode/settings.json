{
  "editor.tabSize": 4,
  "editor.insertSpaces": false,
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": ["javascript", "typescript", "svelte"],
  "files.associations": {
    "*.svelte": "svelte"
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  }
}
